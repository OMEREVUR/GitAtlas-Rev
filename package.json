{
  "name": "gitatlas-rev",
  "displayName": "GitAtlas-Rev",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "Omer-Cayir",
  "icon": "icons/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/OMEREVUR/GitAtlas-Rev.git"
  },
  "bugs": {
    "url": "https://github.com/OMEREVUR/GitAtlas-Rev/issues"
  },
  "homepage": "https://github.com/OMEREVUR/GitAtlas-Rev#readme",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "treemap",
    "visualization",
    "churn",
    "hotspot",
    "code map",
    "commit graph",
    "git graph",
    "branches",
    "pull request",
    "github",
    "heatmap",
    "contributors",
    "time machine",
    "codebase overview"
  ],
  "galleryBanner": {
    "color": "#1B1C20",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:gitatlas-revrev.editor"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitatlas-revrev",
          "title": "GitAtlas-Rev",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitatlas-revrev": [
        {
          "type": "webview",
          "id": "gitatlas-revrev.panel",
          "name": "%view.panel%"
        },
        {
          "id": "gitatlas-revrev.branches",
          "name": "%view.branches%"
        }
      ]
    },
    "commands": [
      {
        "command": "gitatlas-revrev.refresh",
        "title": "%command.refresh%",
        "category": "GitAtlas-Rev",
        "icon": "$(refresh)"
      },
      {
        "command": "gitatlas-revrev.openInEditor",
        "title": "%command.openInEditor%",
        "category": "GitAtlas-Rev",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitatlas-revrev.selectRepo",
        "title": "%command.selectRepo%",
        "category": "GitAtlas-Rev",
        "icon": "$(repo)"
      },
      {
        "command": "gitatlas-revrev.refreshBranches",
        "title": "%command.refreshBranches%",
        "category": "GitAtlas-Rev",
        "icon": "$(refresh)"
      },
      {
        "command": "gitatlas-revrev.github.connect",
        "title": "%command.github.connect%",
        "category": "GitAtlas-Rev",
        "icon": "$(github)"
      },
      {
        "command": "gitatlas-revrev.github.refresh",
        "title": "%command.github.refresh%",
        "category": "GitAtlas-Rev",
        "icon": "$(sync)"
      },
      {
        "command": "gitatlas-revrev.git.fetch",
        "title": "%command.git.fetch%",
        "category": "GitAtlas-Rev",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitatlas-revrev.git.pull",
        "title": "%command.git.pull%",
        "category": "GitAtlas-Rev",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitatlas-revrev.git.push",
        "title": "%command.git.push%",
        "category": "GitAtlas-Rev",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitatlas-revrev.git.commit",
        "title": "%command.git.commit%",
        "category": "GitAtlas-Rev",
        "icon": "$(check)"
      },
      {
        "command": "gitatlas-revrev.branch.checkout",
        "title": "%command.branch.checkout%",
        "category": "GitAtlas-Rev",
        "icon": "$(check)"
      },
      {
        "command": "gitatlas-revrev.branch.create",
        "title": "%command.branch.create%",
        "category": "GitAtlas-Rev",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "gitatlas-revrev.branch.merge",
        "title": "%command.branch.merge%",
        "category": "GitAtlas-Rev",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitatlas-revrev.branch.rename",
        "title": "%command.branch.rename%",
        "category": "GitAtlas-Rev",
        "icon": "$(edit)"
      },
      {
        "command": "gitatlas-revrev.branch.delete",
        "title": "%command.branch.delete%",
        "category": "GitAtlas-Rev",
        "icon": "$(trash)"
      },
      {
        "command": "gitatlas-revrev.showGitOutput",
        "title": "%command.showGitOutput%",
        "category": "GitAtlas-Rev",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitatlas-revrev.refresh",
          "when": "view == gitatlas-revrev.panel",
          "group": "navigation"
        },
        {
          "command": "gitatlas-revrev.openInEditor",
          "when": "view == gitatlas-revrev.panel",
          "group": "navigation"
        },
        {
          "command": "gitatlas-revrev.refreshBranches",
          "when": "view == gitatlas-revrev.branches",
          "group": "navigation"
        },
        {
          "command": "gitatlas-revrev.branch.create",
          "when": "view == gitatlas-revrev.branches",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitatlas-revrev.branch.checkout",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-(local|remote)$/",
          "group": "1_branch@1"
        },
        {
          "command": "gitatlas-revrev.branch.create",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-/",
          "group": "1_branch@2"
        },
        {
          "command": "gitatlas-revrev.branch.merge",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-(local|remote)$/",
          "group": "2_change@1"
        },
        {
          "command": "gitatlas-revrev.branch.rename",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-local/",
          "group": "2_change@2"
        },
        {
          "command": "gitatlas-revrev.branch.delete",
          "when": "view == gitatlas-revrev.branches && viewItem == branch-local",
          "group": "3_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitatlas-revrev.branch.checkout",
          "when": "false"
        },
        {
          "command": "gitatlas-revrev.branch.merge",
          "when": "false"
        },
        {
          "command": "gitatlas-revrev.branch.rename",
          "when": "false"
        },
        {
          "command": "gitatlas-revrev.branch.delete",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitAtlas-Rev",
      "properties": {
        "gitatlas-revrev.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "%config.ignore%"
        },
        "gitatlas-revrev.defaultRange": {
          "type": "string",
          "enum": [
            "7d",
            "30d",
            "all"
          ],
          "enumItemLabels": [
            "%config.defaultRange.7d%",
            "%config.defaultRange.30d%",
            "%config.defaultRange.all%"
          ],
          "default": "30d",
          "markdownDescription": "%config.defaultRange%"
        },
        "gitatlas-revrev.graph.initialCommits": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "markdownDescription": "%config.graph.initialCommits%"
        },
        "gitatlas-revrev.explorer.badges": {
          "type": "string",
          "enum": [
            "hot",
            "all",
            "off"
          ],
          "enumItemLabels": [
            "%config.explorer.badges.hot%",
            "%config.explorer.badges.all%",
            "%config.explorer.badges.off%"
          ],
          "enumDescriptions": [
            "%config.explorer.badges.hot.desc%",
            "%config.explorer.badges.all.desc%",
            "%config.explorer.badges.off.desc%"
          ],
          "default": "hot",
          "markdownDescription": "%config.explorer.badges%"
        },
        "gitatlas-revrev.github.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.github.enabled%"
        },
        "gitatlas-revrev.github.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "%config.github.refreshInterval%"
        },
        "gitatlas-revrev.git.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.git.path%"
        },
        "gitatlas-revrev.git.pullStrategy": {
          "type": "string",
          "enum": [
            "ask",
            "merge",
            "rebase"
          ],
          "enumItemLabels": [
            "%config.git.pullStrategy.ask%",
            "%config.git.pullStrategy.merge%",
            "%config.git.pullStrategy.rebase%"
          ],
          "default": "ask",
          "markdownDescription": "%config.git.pullStrategy%"
        },
        "gitatlas-revrev.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "tr"
          ],
          "enumItemLabels": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.tr%"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        }
      }
    },
    "walkthroughs": [
      {
        "id": "start",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "openMap",
            "title": "%walkthrough.openMap.title%",
            "description": "%walkthrough.openMap.description%",
            "media": {
              "image": "media/walkthrough/map.png",
              "altText": "%walkthrough.openMap.alt%"
            },
            "completionEvents": [
              "onView:gitatlas-revrev.panel"
            ]
          },
          {
            "id": "highlight",
            "title": "%walkthrough.highlight.title%",
            "description": "%walkthrough.highlight.description%",
            "media": {
              "image": "media/walkthrough/highlight.png",
              "altText": "%walkthrough.highlight.alt%"
            }
          },
          {
            "id": "openEditor",
            "title": "%walkthrough.openEditor.title%",
            "description": "%walkthrough.openEditor.description%",
            "media": {
              "image": "media/walkthrough/editor.png",
              "altText": "%walkthrough.openEditor.alt%"
            },
            "completionEvents": [
              "onCommand:gitatlas-revrev.openInEditor"
            ]
          },
          {
            "id": "repos",
            "title": "%walkthrough.repos.title%",
            "description": "%walkthrough.repos.description%",
            "media": {
              "image": "media/walkthrough/repos.png",
              "altText": "%walkthrough.repos.alt%"
            },
            "completionEvents": [
              "onCommand:gitatlas-revrev.selectRepo"
            ]
          },
          {
            "id": "github",
            "title": "%walkthrough.github.title%",
            "description": "%walkthrough.github.description%",
            "media": {
              "image": "media/walkthrough/github.png",
              "altText": "%walkthrough.github.alt%"
            },
            "completionEvents": [
              "onCommand:gitatlas-revrev.github.connect"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "bash scripts/make-fixture.sh",
    "vscode:prepublish": "node esbuild.mjs --production",
    "try-fixture": "node scripts/run-ts.mjs scripts/try-fixture.ts",
    "preview": "npm run build && node scripts/run-ts.mjs scripts/preview.ts"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "d3-hierarchy": "^3.1.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
