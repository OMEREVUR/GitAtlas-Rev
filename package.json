{
  "name": "gitatlas-revrev",
  "displayName": "GitAtlas-RevRev",
  "description": "Repoyu tek bakışta okutan harita: dosyalar satır sayısına göre boyutlanır, değişim sıklığına göre renklenir.",
  "version": "0.1.0",
  "publisher": "OmerCayir43",
  "icon": "icons/icon.png",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:gitatlas-revrev.editor"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitatlas-revrev",
          "title": "GitAtlas-RevRev",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "gitatlas-revrev": [
        {
          "type": "webview",
          "id": "gitatlas-revrev.panel",
          "name": "Harita"
        },
        {
          "id": "gitatlas-revrev.branches",
          "name": "Branch'ler"
        }
      ]
    },
    "commands": [
      {
        "command": "gitatlas-revrev.refresh",
        "title": "Yenile",
        "category": "GitAtlas-RevRev",
        "icon": "$(refresh)"
      },
      {
        "command": "gitatlas-revrev.openInEditor",
        "title": "Haritayı düzenleyicide aç",
        "category": "GitAtlas-RevRev",
        "icon": "$(open-preview)"
      },
      {
        "command": "gitatlas-revrev.refreshBranches",
        "title": "Branch'leri yenile",
        "category": "GitAtlas-RevRev",
        "icon": "$(refresh)"
      },
      {
        "command": "gitatlas-revrev.github.connect",
        "title": "GitHub ile bağlan",
        "category": "GitAtlas-RevRev",
        "icon": "$(github)"
      },
      {
        "command": "gitatlas-revrev.github.refresh",
        "title": "GitHub verisini yenile",
        "category": "GitAtlas-RevRev",
        "icon": "$(sync)"
      },
      {
        "command": "gitatlas-revrev.git.fetch",
        "title": "Getir (fetch)",
        "category": "GitAtlas-RevRev",
        "icon": "$(cloud-download)"
      },
      {
        "command": "gitatlas-revrev.git.pull",
        "title": "Çek (pull)",
        "category": "GitAtlas-RevRev",
        "icon": "$(arrow-down)"
      },
      {
        "command": "gitatlas-revrev.git.push",
        "title": "Gönder (push)",
        "category": "GitAtlas-RevRev",
        "icon": "$(arrow-up)"
      },
      {
        "command": "gitatlas-revrev.git.commit",
        "title": "Commit oluştur",
        "category": "GitAtlas-RevRev",
        "icon": "$(check)"
      },
      {
        "command": "gitatlas-revrev.branch.checkout",
        "title": "Bu branch'e geç",
        "category": "GitAtlas-RevRev",
        "icon": "$(check)"
      },
      {
        "command": "gitatlas-revrev.branch.create",
        "title": "Yeni branch…",
        "category": "GitAtlas-RevRev",
        "icon": "$(git-branch-create)"
      },
      {
        "command": "gitatlas-revrev.branch.merge",
        "title": "Mevcut branch'e birleştir (merge)",
        "category": "GitAtlas-RevRev",
        "icon": "$(git-merge)"
      },
      {
        "command": "gitatlas-revrev.branch.rename",
        "title": "Yeniden adlandır…",
        "category": "GitAtlas-RevRev",
        "icon": "$(edit)"
      },
      {
        "command": "gitatlas-revrev.branch.delete",
        "title": "Sil…",
        "category": "GitAtlas-RevRev",
        "icon": "$(trash)"
      },
      {
        "command": "gitatlas-revrev.showGitOutput",
        "title": "Git çıktısını göster",
        "category": "GitAtlas-RevRev",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitatlas-revrev.refresh",
          "when": "view == gitatlas-revrev.panel",
          "group": "navigation"
        },
        {
          "command": "gitatlas-revrev.openInEditor",
          "when": "view == gitatlas-revrev.panel",
          "group": "navigation"
        },
        {
          "command": "gitatlas-revrev.refreshBranches",
          "when": "view == gitatlas-revrev.branches",
          "group": "navigation"
        },
        {
          "command": "gitatlas-revrev.branch.create",
          "when": "view == gitatlas-revrev.branches",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "gitatlas-revrev.branch.checkout",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-(local|remote)$/",
          "group": "1_branch@1"
        },
        {
          "command": "gitatlas-revrev.branch.create",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-/",
          "group": "1_branch@2"
        },
        {
          "command": "gitatlas-revrev.branch.merge",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-(local|remote)$/",
          "group": "2_change@1"
        },
        {
          "command": "gitatlas-revrev.branch.rename",
          "when": "view == gitatlas-revrev.branches && viewItem =~ /^branch-local/",
          "group": "2_change@2"
        },
        {
          "command": "gitatlas-revrev.branch.delete",
          "when": "view == gitatlas-revrev.branches && viewItem == branch-local",
          "group": "3_danger@1"
        }
      ],
      "commandPalette": [
        {
          "command": "gitatlas-revrev.branch.checkout",
          "when": "false"
        },
        {
          "command": "gitatlas-revrev.branch.merge",
          "when": "false"
        },
        {
          "command": "gitatlas-revrev.branch.rename",
          "when": "false"
        },
        {
          "command": "gitatlas-revrev.branch.delete",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "GitAtlas-RevRev",
      "properties": {
        "gitatlas-revrev.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Haritadan ve rozetlerden hariç tutulacak ek glob desenleri (ör. `src/generated/**`). Varsayılan olarak `node_modules`, `dist`, `out`, `build`, `*.lock`, `package-lock.json` ve `*.min.js` zaten hariçtir."
        },
        "gitatlas-revrev.defaultRange": {
          "type": "string",
          "enum": [
            "7d",
            "30d",
            "all"
          ],
          "enumItemLabels": [
            "7 gün",
            "30 gün",
            "Tümü"
          ],
          "default": "30d",
          "markdownDescription": "Panel açıldığında seçili olan zaman aralığı."
        },
        "gitatlas-revrev.graph.initialCommits": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "markdownDescription": "Graph'ta ilk yüklenecek commit sayısı. Daha eskileri kaydırdıkça yüklenir."
        },
        "gitatlas-revrev.explorer.badges": {
          "type": "string",
          "enum": [
            "hot",
            "all",
            "off"
          ],
          "enumItemLabels": [
            "Sıcaklar",
            "Hepsi",
            "Kapalı"
          ],
          "enumDescriptions": [
            "Yalnızca en sık değişen dosyalarda ●● / ● rozeti.",
            "Değişen her dosyada 1–5 ısı seviyesi.",
            "Rozet yok."
          ],
          "default": "hot",
          "markdownDescription": "Gezgin'deki dosya adlarının yanında hangi rozetlerin görüneceği. GitHub bağlıyken aynı dosyaya 2+ açık PR dokunuyorsa PR sayısı ısının önüne geçer."
        },
        "gitatlas-revrev.github.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "GitHub katmanı (açık PR'lar, çakışma uyarısı, CI). Token gerekmez; VS Code'daki GitHub oturumu kullanılır."
        },
        "gitatlas-revrev.github.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "GitHub verisinin yenilenme aralığı, dakika. Sadece panel açıkken yenilenir; istek limiti azalınca otomatik uzar."
        },
        "gitatlas-revrev.git.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Git yolu. Boş bırakılırsa VS Code'un `git.path` ayarı, o da boşsa PATH'teki `git` kullanılır."
        },
        "gitatlas-revrev.git.pullStrategy": {
          "type": "string",
          "enum": [
            "ask",
            "merge",
            "rebase"
          ],
          "enumItemLabels": [
            "Sor",
            "Merge",
            "Rebase"
          ],
          "default": "ask",
          "markdownDescription": "Pull fast-forward ile yapılamadığında ne yapılacağı. Varsayılan: her seferinde sor."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "bash scripts/make-fixture.sh",
    "vscode:prepublish": "node esbuild.mjs --production",
    "try-fixture": "node scripts/run-ts.mjs scripts/try-fixture.ts",
    "preview": "npm run build && node scripts/run-ts.mjs scripts/preview.ts"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "d3-hierarchy": "^3.1.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
