{
  "name": "rewiewrev",
  "displayName": "RewiewRev",
  "description": "Repoyu tek bakışta okutan harita: dosyalar satır sayısına göre boyutlanır, değişim sıklığına göre renklenir.",
  "version": "0.1.0",
  "publisher": "rewiewrev",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:rewiewrev.editor"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rewiewrev",
          "title": "RewiewRev",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "rewiewrev": [
        {
          "type": "webview",
          "id": "rewiewrev.panel",
          "name": "Harita"
        },
        {
          "id": "rewiewrev.branches",
          "name": "Branch'ler"
        }
      ]
    },
    "commands": [
      {
        "command": "rewiewrev.refresh",
        "title": "Yenile",
        "category": "RewiewRev",
        "icon": "$(refresh)"
      },
      {
        "command": "rewiewrev.openInEditor",
        "title": "Haritayı düzenleyicide aç",
        "category": "RewiewRev",
        "icon": "$(open-preview)"
      },
      {
        "command": "rewiewrev.refreshBranches",
        "title": "Branch'leri yenile",
        "category": "RewiewRev",
        "icon": "$(refresh)"
      },
      {
        "command": "rewiewrev.github.connect",
        "title": "GitHub ile bağlan",
        "category": "RewiewRev",
        "icon": "$(github)"
      },
      {
        "command": "rewiewrev.github.refresh",
        "title": "GitHub verisini yenile",
        "category": "RewiewRev",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rewiewrev.refresh",
          "when": "view == rewiewrev.panel",
          "group": "navigation"
        },
        {
          "command": "rewiewrev.openInEditor",
          "when": "view == rewiewrev.panel",
          "group": "navigation"
        },
        {
          "command": "rewiewrev.refreshBranches",
          "when": "view == rewiewrev.branches",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "RewiewRev",
      "properties": {
        "rewiewrev.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Haritadan ve rozetlerden hariç tutulacak ek glob desenleri (ör. `src/generated/**`). Varsayılan olarak `node_modules`, `dist`, `out`, `build`, `*.lock`, `package-lock.json` ve `*.min.js` zaten hariçtir."
        },
        "rewiewrev.defaultRange": {
          "type": "string",
          "enum": [
            "7d",
            "30d",
            "all"
          ],
          "enumItemLabels": [
            "7 gün",
            "30 gün",
            "Tümü"
          ],
          "default": "30d",
          "markdownDescription": "Panel açıldığında seçili olan zaman aralığı."
        },
        "rewiewrev.graph.initialCommits": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 5000,
          "markdownDescription": "Graph'ta ilk yüklenecek commit sayısı. Daha eskileri kaydırdıkça yüklenir."
        },
        "rewiewrev.explorer.badges": {
          "type": "string",
          "enum": [
            "hot",
            "all",
            "off"
          ],
          "enumItemLabels": [
            "Sıcaklar",
            "Hepsi",
            "Kapalı"
          ],
          "enumDescriptions": [
            "Yalnızca en sık değişen dosyalarda ●● / ● rozeti.",
            "Değişen her dosyada 1–5 ısı seviyesi.",
            "Rozet yok."
          ],
          "default": "hot",
          "markdownDescription": "Gezgin'deki dosya adlarının yanında hangi rozetlerin görüneceği. GitHub bağlıyken aynı dosyaya 2+ açık PR dokunuyorsa PR sayısı ısının önüne geçer."
        },
        "rewiewrev.github.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "GitHub katmanı (açık PR'lar, çakışma uyarısı, CI). Token gerekmez; VS Code'daki GitHub oturumu kullanılır."
        },
        "rewiewrev.github.refreshInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "GitHub verisinin yenilenme aralığı, dakika. Sadece panel açıkken yenilenir; istek limiti azalınca otomatik uzar."
        },
        "rewiewrev.git.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Git yolu. Boş bırakılırsa VS Code'un `git.path` ayarı, o da boşsa PATH'teki `git` kullanılır."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fixture": "bash scripts/make-fixture.sh",
    "vscode:prepublish": "node esbuild.mjs --production",
    "try-fixture": "node scripts/run-ts.mjs scripts/try-fixture.ts",
    "preview": "npm run build && node scripts/run-ts.mjs scripts/preview.ts"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24",
    "d3-hierarchy": "^3.1.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
